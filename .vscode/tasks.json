{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Rebuild the daemon + plugin bundle (cached). Sandbox needs the bundle.",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "dependsOn": ["stop daemon"],
      "dependsOrder": "sequence"
    },
    {
      "label": "stop daemon",
      "detail": "Kill the running dev daemon so the sandbox shell lazy-spawns the freshly built one.",
      "type": "shell",
      "command": "pkill -f '[b]in/autopilotd' || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // ---- eval harness (cmd/eval) ------------------------------------------
    // NOTE: tasks.json has no "envFile" key, so every eval task below sources
    // sandbox/.env itself. The file is plain shell holding `export` lines, so
    // sourcing is enough to get the keys into the environment.
    {
      "label": "eval: dry-run",
      "detail": "Run the eval harness against the scripted stub provider. No network, no API key, no cost.",
      "type": "shell",
      "command": "go run ./cmd/eval -out ./internal/eval/.reports -dry-run",
      "options": {
        "cwd": "${workspaceFolder}/daemon"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "eval: judge-validate (prompted)",
      "detail": "Score candidate judge models against the hand labels. Exits non-zero below the 90% agreement gate.",
      "type": "shell",
      "command": ". \"${workspaceFolder}/sandbox/.env\" && go run ./cmd/eval -judge-validate -judges '${input:evalJudges}'",
      "options": {
        "cwd": "${workspaceFolder}/daemon"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "eval: custom args (prompted)",
      "detail": "Escape hatch: prompts for a raw cmd/eval flag string (-matrix, -import, -diff, -out, ...) with sandbox/.env loaded. Defaults -out to ./internal/eval/.reports; add your own -out in the prompt to override (flag package: last wins).",
      "type": "shell",
      "command": ". \"${workspaceFolder}/sandbox/.env\" && go run ./cmd/eval -out ./internal/eval/.reports ${input:evalArgs}",
      "options": {
        "cwd": "${workspaceFolder}/daemon"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ],

  // VS Code prompts for each of these the first time it is referenced in a
  // task run, and remembers the answer for the rest of the window session.
  "inputs": [
    {
      "id": "evalJudges",
      "type": "promptString",
      "description": "Judge model ids, comma-separated. NB: Gemini ids use DOTS (gemini-3.5-flash-lite), not dashes.",
      "default": "gemini-3.5-flash-lite"
    },
    {
      "id": "evalArgs",
      "type": "promptString",
      "description": "Raw cmd/eval flags, e.g. -matrix -out /tmp/sc.json",
      "default": "-cases syntax"
    }
  ]
}
