#!/bin/sh
# Pre-commit checks. Enable with: make hooks (sets core.hooksPath=.githooks).
set -e

# 1. Regenerate the committed zsh bundle and stage it, so it can never drift
#    from the fragments. Built from the WORKING TREE, so `git add -p` of a
#    partial fragment hunk bundles the whole working-tree fragment.
make plugin >/dev/null
git add zsh-autopilot.zsh

# 2. zsh -n parses without executing, catching syntax errors before commit.
zsh -n zsh-autopilot.zsh

git diff --cached --name-only --diff-filter=ACM -- '*.go' | while IFS= read -r f; do
	[ -n "$f" ] || continue
	gofmt -w "$f"
	git add "$f"
done
