# Example eval.toml for the eval harness (daemon/cmd/eval).

# Copy this to internal/eval/eval.toml (gitignored); -profiles then accepts
# names from it too, not just preset brands. -config points at a different
# path instead.

# Independent of the daemon's own config.toml: the harness never reads
# ZSH_AUTOPILOT_CONFIG or ~/.config/autopilot/config.toml, so a profile
# added here has no effect on the running daemon and vice versa.

# A profile's `provider` field is still a brand: a preset
# (anthropic/codestral/groq/ollama/qwen) or the "openai" escape hatch, as used
# by the Fireworks example below.

# [profiles.fw-qwen30b]
# provider = "openai"
# base_url = "https://api.fireworks.ai/inference/v1"
# model = "accounts/fireworks/models/qwen3-coder-30b-a3b-instruct"
# api_key_env = "ZSH_AUTOPILOT_FIREWORKS_KEY"

# Then: go run ./cmd/eval -profiles fw-qwen30b,codestral
