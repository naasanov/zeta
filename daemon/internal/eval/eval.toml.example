# Example eval.toml for the eval harness (daemon/cmd/eval).
#
# Copy this to internal/eval/eval.toml (gitignored) and -providers will
# accept profile names from it, not just preset brands
# (codestral/anthropic/groq/ollama). -config points at a different path
# instead, if you'd rather keep it elsewhere.
#
# This is independent of the daemon's own config.toml (see
# sandbox/config.toml.example): the harness never reads ZSH_AUTOPILOT_CONFIG
# or ~/.config/autopilot/config.toml, so a profile added here has no effect
# on the running daemon and vice versa.
#
# A profile's `provider` field is still a BRAND: a preset
# (anthropic/codestral/groq/ollama) or the "openai" escape hatch for any
# other OpenAI-compatible endpoint. The example below reaches Fireworks
# through that escape hatch.

# [profiles.fw-qwen30b]
# provider = "openai"
# base_url = "https://api.fireworks.ai/inference/v1"
# model = "accounts/fireworks/models/qwen3-coder-30b-a3b-instruct"
# api_key_env = "ZSH_AUTOPILOT_FIREWORKS_KEY"

# Then: go run ./cmd/eval -providers fw-qwen30b,codestral
