# Build output
/bin/
/dist/
*.test
*.out

# Stray binaries from `go build ./cmd/X` run inside daemon/ (the Makefile
# targets bin/ instead). Untracked deliberately — one was committed and grew
# to 50MB before anyone noticed.
/daemon/autopilotd
/daemon/eval

# Go
daemon/vendor/

# Delve debug binaries (created by the "daemon (debug)" launch config)
__debug_bin*

# Runtime
*.sock

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json

# Sandbox
sandbox/.zsh_history
sandbox/.env
sandbox/config.toml
sandbox/.metrics/
sandbox/.history/
sandbox/.state/

# Eval reports (VS Code task default -out dir)
daemon/internal/eval/.reports/*
!daemon/internal/eval/.reports/.gitkeep