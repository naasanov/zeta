# Sandbox developer env — copy to sandbox/.env (gitignored) and fill in.
#
# sandbox/.zshrc sources this AFTER setting the sandbox defaults, so anything
# here wins. Every line is a real `export`, so plain sourcing is enough; the
# VS Code eval tasks source it the same way.
#
# Only secrets and deliberate overrides belong here. Paths, sockets, the daemon
# binary and the metrics/history locations are all derived in sandbox/.zshrc.
#
# The sandbox unsets every inherited ZSH_AUTOPILOT_* first, so a key exported by
# your real ~/.zshrc will NOT reach it. This file is the only source.

# REQUIRED: which provider to run, plus its key. The daemon exits at startup if
# no provider is selected here or via default_profile in config.toml. Without a
# key it starts but suggests nothing, and says so in the shell.
export ZSH_AUTOPILOT_PROVIDER=codestral
export ZSH_AUTOPILOT_CODESTRAL_KEY=

# Keys for the other brand presets, needed only if you switch provider above.
# ollama needs none (local, no key).
# export ZSH_AUTOPILOT_GROQ_KEY=
# export ZSH_AUTOPILOT_ANTHROPIC_KEY=

# Eval harness (.docs/eval_harness_plan.md) — the LLM judge used by the judged
# cases (C3/E3/E7/F2). Only needed to run evals, never by the daemon. Without a
# key the judged cases report 0/0 FAIL as "NEVER EVALUATED" rather than
# silently passing, so a missing key degrades loudly.
# export ZSH_AUTOPILOT_EVAL_JUDGE_KEY=
# export ZSH_AUTOPILOT_EVAL_JUDGE_MODEL=gemini-3.5-flash-lite
# export ZSH_AUTOPILOT_EVAL_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# export ZSH_AUTOPILOT_EVAL_JUDGE_CACHE=

# Overrides applied on top of the selected provider's preset/profile.
# export ZSH_AUTOPILOT_BASE_URL=https://api.groq.com/openai/v1
# export ZSH_AUTOPILOT_MODEL=llama-3.3-70b-versatile

# Overrides of the sandbox defaults in .zshrc, if you need them. A config.toml
# in this dir (copy config.toml.example) is picked up automatically.
# export ZSH_AUTOPILOT_DEBUG=0
# export ZSH_AUTOPILOT_METRICS=0
