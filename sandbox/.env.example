# Sandbox developer env: copy to sandbox/.env (gitignored) and fill in.
# Sourced after sandbox/.zshrc's defaults, so anything here wins; every
# line is a real `export`.
#
# Only secrets and deliberate overrides belong here; sandbox/.zshrc derives
# everything else.
#
# The sandbox unsets every inherited ZSH_AUTOPILOT_*, so keys from your real
# ~/.zshrc won't reach it.

# REQUIRED: which provider to run, plus its key. The daemon exits at startup if
# no provider is selected here or via default_profile in config.toml. Without a
# key it starts but suggests nothing, and says so in the shell.
export ZSH_AUTOPILOT_PROVIDER=codestral
export ZSH_AUTOPILOT_CODESTRAL_KEY=

# Keys for the other brand presets, needed only if you switch provider
# above. ollama needs none (local, no key).

# export ZSH_AUTOPILOT_GROQ_KEY=
# export ZSH_AUTOPILOT_ANTHROPIC_KEY=

# Eval harness judge key. Only needed to run evals, never by the daemon.
# Without it, judged cases report "NEVER EVALUATED" instead of silently
# passing.

# export ZSH_AUTOPILOT_EVAL_JUDGE_KEY=
# export ZSH_AUTOPILOT_EVAL_JUDGE_MODEL=gemini-3.5-flash-lite

# export ZSH_AUTOPILOT_EVAL_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# export ZSH_AUTOPILOT_EVAL_JUDGE_CACHE=

# Overrides applied on top of the selected provider's preset/profile.
# export ZSH_AUTOPILOT_BASE_URL=https://api.groq.com/openai/v1
# export ZSH_AUTOPILOT_MODEL=llama-3.3-70b-versatile

# Overrides of the sandbox defaults in .zshrc. A config.toml in this dir
# (copy config.toml.example) is picked up automatically.

# export ZSH_AUTOPILOT_DEBUG=0
# export ZSH_AUTOPILOT_METRICS=0
